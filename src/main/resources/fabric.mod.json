{
  "schemaVersion": 1,
  "id": "incontrol",
  "version": "${version}",
  "name": "InControl",
  "description": "Be in control of mob spawns, loot, experience and world events.",
  "authors": ["McJty"],
  "license": "MIT",
  "contact": { "homepage": "https://mcjty.eu/docs/mods/control-mods", "sources": "https://github.com/McJtyMods/InControl", "issues": "https://github.com/McJtyMods/InControl/issues" },
  "environment": "*",
  "entrypoints": { "main": ["mcjty.incontrol.InControl"] },
  "mixins": ["incontrol.mixins.json"],
  "accessWidener": "incontrol.accesswidener",
  "depends": { "fabricloader": ">=${fabric_loader_version}", "minecraft": "~${minecraft_version}", "java": ">=${java_version}", "fabric-api": ">=${fabric_api_version}" }
}
